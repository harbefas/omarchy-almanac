#!/usr/bin/env python3
"""Edit or delete a single khal event, addressed by UID.

`khal edit` is interactive-only, so mutation has to go at the storage
directly. Filesystem calendars keep one .ics per event, so an edit is a
rewrite of that file and a delete is an unlink; khal reindexes from mtime on
its next run.

The file is located by reading UIDs rather than trusting the filename:
vdirsyncer and `khal new` both name files after the UID, but nothing in the
format requires it.

Moving an event between calendars is a file move: filesystem calendars are
directories, so the event keeps its UID and its contents and changes which
directory holds it.

Usage:
  khal-event-edit <uid> --title T [--start ISO] [--end ISO]
                        [--location L] [--description D] [--calendar NAME]
  khal-event-edit <uid> --delete
"""

import argparse
import json
import os
import select
import stat
import signal
import subprocess
import sys
import time
from datetime import date, datetime
from pathlib import Path

import icalendar

sys.path.insert(0, str(Path(__file__).resolve().parent))

import almanac_fs  # noqa: E402

HERE = Path(__file__).resolve().parent


# Ceilings, for the same reason the panel has them: an .ics is written by
# whoever publishes the feed, and neither a runaway file nor a runaway helper
# gets to decide how much memory this takes to read one event.
MAX_HELPER_OUTPUT = 1024 * 1024
MAX_ICS_BYTES = 4 * 1024 * 1024
# The helper reads a config that can live on a mount that has stopped
# answering, where it would neither finish nor say anything for the byte
# ceiling to catch. Overridable so the tests can watch it bite.
MAX_HELPER_SECONDS = float(os.environ.get("KHAL_HELPER_TIMEOUT", 30))
# The search itself is bounded three ways, because a calendar directory is
# filled by vdirsyncer on behalf of whoever publishes the feed. Any one of
# these can be the thing that runs away: the number of files, their total
# size, or a store on a mount that answers each read slowly enough that no
# byte ceiling ever trips.
# Overridable so the tests can watch each ceiling bite without building a
# store big enough to reach it honestly.
# Sized against a real store rather than a tidy one: a handful of sports feeds
# is tens of thousands of files, and a ceiling that refuses to find an event
# somebody can see on their own screen is a bug, not a bound.
MAX_ICS_FILES = int(os.environ.get("KHAL_SEARCH_FILES", 50000))
MAX_SEARCH_BYTES = int(os.environ.get("KHAL_SEARCH_BYTES", 256 * 1024 * 1024))
MAX_COMPONENTS = 500
MAX_SEARCH_SECONDS = float(os.environ.get("KHAL_SEARCH_TIMEOUT", 60))


def kill_group(process):
    """Kill the helper and everything it started, then reap it."""
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        process.kill()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def calendars():
    deadline = time.monotonic() + MAX_HELPER_SECONDS
    # Binary, so the ceiling is counted in the bytes actually read rather than
    # in characters a partial decode would have to guess at.
    # Its own session, so it is a process group leader: khal-calendars runs a
    # pipeline of its own, and killing the one process this holds would leave
    # the rest of that pipeline behind.
    process = subprocess.Popen(
        [str(HERE / "khal-calendars")], stdout=subprocess.PIPE, start_new_session=True
    )

    chunks = []
    read_so_far = 0
    over = False
    timed_out = False

    while read_so_far <= MAX_HELPER_OUTPUT:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break

        ready, _, _ = select.select([process.stdout], [], [], remaining)
        if not ready:
            timed_out = True
            break

        chunk = os.read(process.stdout.fileno(), MAX_HELPER_OUTPUT + 1 - read_so_far)
        if not chunk:
            break

        chunks.append(chunk)
        read_so_far += len(chunk)

    out = b"".join(chunks).decode("utf-8", "replace")
    over = len(out) > MAX_HELPER_OUTPUT

    if over or timed_out:
        kill_group(process)
        process.stdout.close()
        if timed_out:
            sys.exit(f"khal-calendars did not finish within {MAX_HELPER_SECONDS:g}s")
        sys.exit("khal-calendars produced more output than can be read")

    process.stdout.close()
    try:
        status = process.wait(timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        kill_group(process)
        sys.exit(f"khal-calendars did not finish within {MAX_HELPER_SECONDS:g}s")
    if status != 0:
        sys.exit("khal-calendars failed")

    return json.loads(out)


def read_ics(dir_fd, name):
    """The file's bytes, or None if it is not an event worth parsing.

    Opened relative to the directory descriptor the search is holding, so the
    file read is the entry that was listed and not whatever took its name in
    the meantime. A symlink is refused, and one event per file is the format,
    so anything past the ceiling is not an event and parsing it would cost
    more than the whole search.
    """
    try:
        fd = os.open(
            name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            dir_fd=dir_fd,
        )
    except OSError:
        return None, None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_ICS_BYTES:
            return None, None
        return almanac_fs.read_fd(fd, MAX_ICS_BYTES), info
    finally:
        os.close(fd)


class Found:
    """Where an event was found, in terms that survive the search.

    The directory descriptor and the file's identity are kept, not its path:
    the mutation has to happen in the same directory that was inspected, on
    the same file, and a name is not enough to promise either.
    """

    def __init__(self, calendar, dir_fd, name, info, cal_obj, component):
        self.calendar = calendar
        self.dir_fd = dir_fd
        self.name = name
        self.info = info
        self.cal_obj = cal_obj
        self.component = component


def find_event(uid):
    """Return a Found for the event, or exit.

    Bounded by file count, total bytes read and wall clock, all three across
    the whole search rather than per calendar: a store that has stopped making
    sense should not be able to hold the panel open by spreading itself over
    several directories.
    """
    deadline = time.monotonic() + MAX_SEARCH_SECONDS
    files_seen = 0
    bytes_read = 0
    known = calendars()

    # vdirsyncer and `khal new` both name a file after the UID it holds, so
    # the file is usually one open away. Nothing in the format requires that,
    # which is why the walk below still exists, but paying for the walk when
    # the guess is right means reading tens of thousands of files to find one
    # that was named after what was being looked for.
    if uid and "/" not in uid and "\0" not in uid and uid not in (".", ".."):
        for cal in known:
            root = os.path.expanduser(cal["path"])
            if not os.path.isdir(root):
                continue
            dir_fd = almanac_fs.open_directory(root, f"calendar {cal['name']!r}")
            keep_open = False
            try:
                raw, info = read_ics(dir_fd, f"{uid}.ics")
                if raw is None:
                    continue
                try:
                    cal_obj = icalendar.Calendar.from_ical(raw)
                except ValueError:
                    continue
                for component in cal_obj.walk("VEVENT"):
                    if str(component.get("UID", "")) == uid:
                        keep_open = True
                        return Found(
                            cal, dir_fd, f"{uid}.ics", info, cal_obj, component
                        )
            finally:
                if not keep_open:
                    os.close(dir_fd)

    for cal in known:
        root = os.path.expanduser(cal["path"])
        if not os.path.isdir(root):
            continue
        dir_fd = almanac_fs.open_directory(root, f"calendar {cal['name']!r}")
        keep_open = False
        try:
            for entry in os.scandir(dir_fd):
                if not entry.name.endswith(".ics"):
                    continue
                if time.monotonic() > deadline:
                    sys.exit(
                        f"searching for {uid!r} took longer than "
                        f"{MAX_SEARCH_SECONDS:g}s"
                    )
                files_seen += 1
                if files_seen > MAX_ICS_FILES:
                    sys.exit(f"searched {MAX_ICS_FILES} files without finding {uid!r}")

                raw, info = read_ics(dir_fd, entry.name)
                if raw is None:
                    continue
                bytes_read += len(raw)
                if bytes_read > MAX_SEARCH_BYTES:
                    sys.exit(
                        f"read {MAX_SEARCH_BYTES} bytes without finding {uid!r}"
                    )

                try:
                    cal_obj = icalendar.Calendar.from_ical(raw)
                except ValueError:
                    continue
                for seen, component in enumerate(cal_obj.walk("VEVENT")):
                    # One event per file is the format; a file claiming
                    # thousands is not one this should walk to the end of.
                    if seen >= MAX_COMPONENTS:
                        break
                    if str(component.get("UID", "")) == uid:
                        keep_open = True
                        return Found(
                            cal, dir_fd, entry.name, info, cal_obj, component
                        )
        finally:
            if not keep_open:
                os.close(dir_fd)
    sys.exit(f"no event with uid {uid!r}")


def parse_when(value):
    """ISO date or datetime. A bare date means an all-day event."""
    if "T" in value:
        return datetime.fromisoformat(value)
    return date.fromisoformat(value)


# The payload arrives over a pipe when the panel calls this, and a pipe read
# without a ceiling is the same unbounded read as everywhere else.
MAX_PAYLOAD_BYTES = 256 * 1024

PAYLOAD_FIELDS = (
    "uid", "title", "start", "end", "location", "description", "calendar"
)


def read_payload():
    """One JSON object of the fields, read from stdin under a ceiling.

    A title, a location and a description are the private part of a calendar,
    and argv is readable by every process on the machine through /proc, so the
    panel sends them here instead of passing them as arguments.
    """
    raw = sys.stdin.buffer.read(MAX_PAYLOAD_BYTES + 1)
    if len(raw) > MAX_PAYLOAD_BYTES:
        sys.exit(f"the edit payload is larger than {MAX_PAYLOAD_BYTES} bytes")
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        sys.exit("the edit payload was not readable as JSON")
    if not isinstance(payload, dict):
        sys.exit("the edit payload is not an object")

    parsed = argparse.Namespace(delete=bool(payload.get("delete")))
    for field in PAYLOAD_FIELDS:
        value = payload.get(field)
        setattr(parsed, field, None if value is None else str(value))
    if not parsed.uid:
        sys.exit("the edit payload names no event")
    return parsed


def main():
    if "--stdin" in sys.argv[1:]:
        args = read_payload()
        return run(args)

    parser = argparse.ArgumentParser()
    parser.add_argument("uid")
    parser.add_argument("--delete", action="store_true")
    parser.add_argument("--title")
    parser.add_argument("--start")
    parser.add_argument("--end")
    parser.add_argument("--location")
    parser.add_argument("--description")
    parser.add_argument("--calendar", help="move the event to this calendar")
    args = parser.parse_args()
    return run(args)


def run(args):
    found = find_event(args.uid)
    cal, event, cal_obj = found.calendar, found.component, found.cal_obj

    try:
        if cal["readonly"]:
            sys.exit(f"calendar {cal['name']!r} is readonly")

        if args.delete:
            # Checked against the file that was inspected, immediately before
            # unlinking it: a sync running alongside this can put a different
            # event behind the same name, and deleting that one would be
            # deleting something nobody asked about.
            almanac_fs.unlink_leaf(found.dir_fd, found.name, found.info)
            print(
                json.dumps(
                    {"ok": True, "deleted": args.uid, "calendar": cal["name"]}
                )
            )
            return

        fields = {
            "SUMMARY": args.title,
            "LOCATION": args.location,
            "DESCRIPTION": args.description,
        }
        for name, value in fields.items():
            if value is None:
                continue
            event.pop(name, None)
            event.add(name, value)

        for name, value in (("DTSTART", args.start), ("DTEND", args.end)):
            if value is None:
                continue
            event.pop(name, None)
            event.add(name, parse_when(value))

        target_fd = found.dir_fd
        moved_to = cal["name"]
        move = False

        if args.calendar and args.calendar != cal["name"]:
            destination = next(
                (c for c in calendars() if c["name"] == args.calendar), None
            )
            if destination is None:
                sys.exit(f"no calendar named {args.calendar!r}")
            if destination["readonly"]:
                sys.exit(f"calendar {args.calendar!r} is readonly")
            target_fd = almanac_fs.open_directory(
                os.path.expanduser(destination["path"]),
                f"calendar {destination['name']!r}",
            )
            move = True
            moved_to = destination["name"]

        try:
            if move:
                try:
                    os.stat(found.name, dir_fd=target_fd, follow_symlinks=False)
                except FileNotFoundError:
                    pass
                else:
                    sys.exit(f"{found.name} already exists in {args.calendar!r}")

            # Still the file that was read? An edit written over something a
            # sync replaced in the meantime would silently undo the sync.
            if not almanac_fs.same_file(found.dir_fd, found.name, found.info):
                sys.exit(f"{found.name} changed underneath this edit and was left alone")

            # Written to a randomized temp in the destination directory and
            # renamed over the target, both ends relative to the descriptor
            # this is holding, so a crash mid-write cannot leave khal indexing
            # half an event and a move never has it in two places at once.
            almanac_fs.write_leaf(
                target_fd, found.name, cal_obj.to_ical(), prefix="event"
            )

            if move:
                almanac_fs.unlink_leaf(found.dir_fd, found.name, found.info)
        finally:
            if move:
                os.close(target_fd)

        print(json.dumps({"ok": True, "uid": args.uid, "calendar": moved_to}))
    finally:
        os.close(found.dir_fd)


if __name__ == "__main__":
    main()
