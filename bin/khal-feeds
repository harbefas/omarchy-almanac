#!/usr/bin/env python3
"""List, add, remove and sync the .ics feeds behind khal's calendars.

A feed is one vdirsyncer `pair` whose remote is an http storage, writing into
a filesystem storage that khal reads as a calendar. Adding one therefore has
to touch two configs — vdirsyncer's (the pair and its two storages) and
khal's (the calendar entry) — and removing one has to undo both, or khal ends
up pointing at a directory nothing syncs.

Both files are edited as text rather than reparsed and rewritten: they are
hand-maintained and full of comments, and a round-trip through a parser would
throw those away. vdirsyncer's format is ini-like but not TOML (`[pair x]`
has a space in the table name), so there is no stdlib parser for it anyway.

Usage:
  khal-feeds list
  khal-feeds add <name> <url> [--color COLOR]
  khal-feeds remove <name>
  khal-feeds sync [name]
"""

import argparse
import json
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlparse

VDIRSYNCER = Path(
    os.environ.get("VDIRSYNCER_CONFIG", "~/.config/vdirsyncer/config")
).expanduser()
KHAL = Path(os.environ.get("KHAL_CONFIG", "~/.config/khal/config")).expanduser()

# Matches both vdirsyncer's `[pair x]` and khal's nested `[[calendar]]`,
# reporting the inner name either way.
SECTION = re.compile(r"^\[+([^\[\]]+)\]+\s*$")
SETTING = re.compile(r"^([a-z_]+)\s*=\s*(.*)$")
SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")


def die(message):
    sys.exit(message)


def validate_name(name):
    """One section-safe token used for pair, storage, calendar and path names."""
    if not SAFE_NAME.fullmatch(name):
        die("feed name must be 1-64 letters, numbers, dashes or underscores")
    return name


def validate_url(url):
    parsed = urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        die("feed URL must start with http:// or https://")
    if '"' in url or any(char.isspace() for char in url):
        die("feed URL contains characters that cannot be written to vdirsyncer config")
    return url


def validate_color(color):
    if any(char in color for char in ("\r", "\n", "[", "]")) or len(color) > 64:
        die("color contains characters that cannot be written to khal config")
    return color


def require_config(path, label):
    if not path.is_file():
        die(f"{label} config not found at {path}")


def parse(path):
    """[(section-name, {key: value}, [line numbers]) …] in file order."""
    sections = []
    if not path.is_file():
        return sections
    for number, line in enumerate(path.read_text().splitlines()):
        match = SECTION.match(line.strip())
        if match:
            sections.append([match.group(1), {}, [number]])
            continue
        if not sections:
            continue
        sections[-1][2].append(number)
        setting = SETTING.match(line.strip())
        if setting:
            sections[-1][1][setting.group(1)] = setting.group(2).strip().strip('"')
    return sections


def status_dir():
    """Where vdirsyncer records what it last synced, per [general]."""
    for name, values, _ in parse(VDIRSYNCER):
        if name == "general":
            return Path(os.path.expanduser(values.get("status_path", ""))) \
                if values.get("status_path") else None
    return None


def mtime(path):
    try:
        return int(Path(path).stat().st_mtime)
    except OSError:
        return 0


def last_synced(status, pair):
    """When vdirsyncer last ran this pair, or 0 if it never has.

    The .items file is rewritten on every sync whether or not anything came
    back, so this answers "is the sync running" and nothing more.
    """
    return mtime(status / f"{pair}.items") if status is not None else 0


def feeds():
    sections = parse(VDIRSYNCER)
    status = status_dir()
    storages = {
        name.split(None, 1)[1]: values
        for name, values, _ in sections
        if name.startswith("storage ")
    }
    out = []
    for name, values, _ in sections:
        if not name.startswith("pair "):
            continue
        local = storages.get(values.get("a", ""), {})
        remote = storages.get(values.get("b", ""), {})
        if remote.get("type") != "http":
            continue
        pair = name.split(None, 1)[1]
        out.append(
            {
                "name": pair,
                "url": remote.get("url", ""),
                "path": os.path.expanduser(local.get("path", "")),
                "calendar": Path(local.get("path", "").rstrip("/")).name,
                "synced": last_synced(status, pair),
                # When the events themselves last changed. A feed whose
                # upstream went quiet keeps syncing happily, so this is the
                # one that tells them apart — at the cost of looking stale
                # for a calendar that genuinely has no news.
                "changed": mtime(os.path.expanduser(local.get("path", ""))),
            }
        )
    return out


def drop_sections(path, predicate):
    """Rewrite path without the sections predicate(name) selects."""
    lines = path.read_text().splitlines()
    doomed = set()
    for name, _, numbers in parse(path):
        if predicate(name):
            doomed.update(numbers)
            # The blank line that separated this section from the one above
            # goes with it, or removing a feed leaves a widening gap behind.
            above = numbers[0] - 1
            if above >= 0 and lines[above].strip() == "":
                doomed.add(above)
    kept = [line for number, line in enumerate(lines) if number not in doomed]
    path.write_text("\n".join(kept).rstrip("\n") + "\n")


def cmd_list(_args):
    print(json.dumps(feeds(), ensure_ascii=False))


def cmd_add(args):
    name = validate_name(args.name)
    url = validate_url(args.url)
    color = validate_color(args.color)
    require_config(VDIRSYNCER, "vdirsyncer")
    require_config(KHAL, "khal")
    if any(feed["name"] == f"{name}_pair" for feed in feeds()):
        die(f"feed {name!r} already exists")

    path = Path(f"~/.local/share/khal/calendars/{name}/").expanduser()
    path.mkdir(parents=True, exist_ok=True)

    with VDIRSYNCER.open("a") as handle:
        handle.write(
            f"""
[pair {name}_pair]
a = "{name}_local"
b = "{name}_remote"
collections = null
conflict_resolution = "b wins"

[storage {name}_local]
type = "filesystem"
path = "~/.local/share/khal/calendars/{name}/"
fileext = ".ics"

[storage {name}_remote]
type = "http"
url = "{url}"
"""
        )

    # The calendar entry goes before khal's first top-level section, since
    # everything after [sqlite] would be read as a setting of it rather than a
    # new calendar.
    lines = KHAL.read_text().splitlines()
    entry = [
        "",
        f"[[{name}]]",
        f"path = ~/.local/share/khal/calendars/{name}/",
        f"color = {color}",
        "readonly = True",
    ]
    for number, line in enumerate(lines):
        if line.startswith("[") and not line.startswith("[["):
            if number == 0:
                continue
            lines[number:number] = entry
            break
    else:
        lines.extend(entry)
    KHAL.write_text("\n".join(lines).rstrip("\n") + "\n")

    print(json.dumps({"ok": True, "added": name, "calendar": name}))


def cmd_remove(args):
    name = validate_name(args.name)
    require_config(VDIRSYNCER, "vdirsyncer")
    require_config(KHAL, "khal")
    # Where the already-synced copy is left. Removing a feed unregisters it
    # from both configs but does not delete the events: `path` comes from a
    # config the user owns and can point anywhere, so a one-keystroke
    # recursive delete is not a trade worth making. The caller is told where
    # the leftovers are instead.
    orphaned = ""
    for feed in feeds():
        if feed["name"] == f"{name}_pair":
            orphaned = feed["path"]
            break

    drop_sections(
        VDIRSYNCER,
        lambda section: section
        in (f"pair {name}_pair", f"storage {name}_local", f"storage {name}_remote"),
    )
    drop_sections(KHAL, lambda section: section == name)
    print(json.dumps({"ok": True, "removed": name, "orphaned": orphaned}))


# vdirsyncer is as talkative as the servers it is pointed at, and its output
# is quoted back into the JSON this prints, which the shell reads into memory
# and keeps. A feed that answers with a megabyte of complaints per item must
# not decide how much of that memory it gets.
MAX_SYNC_OUTPUT = 64 * 1024

# A byte ceiling only bounds a process that talks. A remote that accepts the
# connection and then says nothing leaves vdirsyncer waiting on it for as long
# as it cares to wait, and the panel waiting on vdirsyncer, so the wall clock
# is bounded as well. Overridable so the tests can watch it bite.
MAX_SYNC_SECONDS = float(os.environ.get("VDIRSYNCER_TIMEOUT", 120))


def kill_and_reap(process):
    process.kill()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def run_bounded(command, timeout=None):
    """Run a command under a byte ceiling and a deadline.

    At most MAX_SYNC_OUTPUT bytes are read, and the whole run is given
    MAX_SYNC_SECONDS.

    Past either limit the process is killed rather than drained: there is
    nothing useful to say about a sync that will not stop talking, and
    draining it politely is exactly the unbounded read being avoided.

    Returns (output, truncated, timed_out, returncode).
    """
    deadline = time.monotonic() + (MAX_SYNC_SECONDS if timeout is None else timeout)
    # Binary, so the ceiling is counted in the bytes actually read rather than
    # in characters a partial decode would have to guess at.
    process = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )

    chunks = []
    read_so_far = 0
    truncated = False
    timed_out = False

    # Read what is there as it arrives rather than blocking on a full buffer,
    # so a producer that goes quiet is measured by the clock and not by how
    # much it has said.
    while read_so_far <= MAX_SYNC_OUTPUT:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break

        ready, _, _ = select.select([process.stdout], [], [], remaining)
        if not ready:
            timed_out = True
            break

        chunk = os.read(process.stdout.fileno(), MAX_SYNC_OUTPUT + 1 - read_so_far)
        if not chunk:  # producer closed its end
            break

        chunks.append(chunk)
        read_so_far += len(chunk)

    output = b"".join(chunks).decode("utf-8", "replace")
    if len(output) > MAX_SYNC_OUTPUT:
        truncated = True
        output = output[:MAX_SYNC_OUTPUT]

    if truncated or timed_out:
        kill_and_reap(process)
        process.stdout.close()
        return output.strip(), truncated, timed_out, process.returncode

    process.stdout.close()
    try:
        process.wait(timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        kill_and_reap(process)
        timed_out = True

    return output.strip(), truncated, timed_out, process.returncode


def cmd_sync(args):
    pairs = [f"{validate_name(args.name)}_pair"] if args.name else []
    # discover writes to its own stdout, which is this helper's stdout, which
    # is the JSON document the panel parses. It is read and dropped.
    # Both runs are bounded, and each gets its own budget: discover talks to
    # the same remotes sync does, so a remote that can hang one can hang both.
    _, _, discover_timed_out, _ = run_bounded(["vdirsyncer", "discover", *pairs])
    output, truncated, timed_out, code = run_bounded(["vdirsyncer", "sync", *pairs])
    timed_out = timed_out or discover_timed_out

    if truncated:
        output = (
            f"sync produced more than {MAX_SYNC_OUTPUT} bytes of output and "
            f"was stopped; the first part of it follows\n\n" + output
        )
    elif timed_out:
        output = (
            f"sync did not finish within {MAX_SYNC_SECONDS:g}s and was stopped; "
            f"whatever it had said by then follows\n\n" + output
        )
    print(
        json.dumps(
            {
                "ok": code == 0 and not truncated and not timed_out,
                "truncated": truncated,
                "timedOut": timed_out,
                "output": output,
            }
        )
    )


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list").set_defaults(run=cmd_list)

    add = sub.add_parser("add")
    add.add_argument("name")
    add.add_argument("url")
    add.add_argument("--color", default="light blue")
    add.set_defaults(run=cmd_add)

    remove = sub.add_parser("remove")
    remove.add_argument("name")
    remove.set_defaults(run=cmd_remove)

    sync = sub.add_parser("sync")
    sync.add_argument("name", nargs="?")
    sync.set_defaults(run=cmd_sync)

    args = parser.parse_args()
    args.run(args)


if __name__ == "__main__":
    main()
