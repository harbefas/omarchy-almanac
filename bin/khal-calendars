#!/usr/bin/env bash
# Emits a JSON array of {name, color, readonly, path} for every calendar in
# khal's config. khal printcalendars gives the names but drops `readonly`,
# which the UI needs to know before it offers to create or delete anything.

set -euo pipefail

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "$1 is not installed or not on PATH" >&2
    exit 127
  }
}

require jq
require stat

config="${KHAL_CONFIG:-$HOME/.config/khal/config}"

# A config is read as a file, not as a name. The symlink is refused before the
# open, and everything after it is decided from the descriptor: whether it is
# a regular file and how big it is. Checking the path and then opening it is
# two different files if something moves in between.
[ -L "$config" ] && {
  echo "khal config at $config is a symlink" >&2
  exit 66
}
# Asked before the open, because opening a fifo blocks until someone writes to
# it, and this helper would sit there rather than refuse it. The descriptor is
# checked again below: this one only decides whether it is safe to open.
[ -f "$config" ] || {
  echo "khal config at $config is not a regular file" >&2
  exit 66
}
exec 3<"$config" || {
  echo "khal config not found at $config" >&2
  exit 66
}
[ "$(stat -L -c %F /dev/fd/3)" = "regular file" ] || {
  echo "khal config at $config is not a regular file" >&2
  exit 66
}

max_config_bytes=$((256 * 1024))
[ "$(stat -L -c %s /dev/fd/3)" -le "$max_config_bytes" ] || {
  echo "khal config at $config is larger than $max_config_bytes bytes" >&2
  exit 66
}

# The calendar ceiling is applied here rather than only in the jq below, so a
# config with a million sections in it is never assembled into one string
# first. awk stops reading at the cap.
max_calendars=500

head -c "$max_config_bytes" <&3 |
  awk -v max="$max_calendars" '
  /^[[:space:]]*\[\[[^]]+\]\][[:space:]]*$/ {
    if (name != "") { print name "\t" color "\t" readonly "\t" path; emitted++ }
    if (emitted >= max) exit
    name = $0
    gsub(/^[[:space:]]*\[\[|\]\][[:space:]]*$/, "", name)
    color = ""; readonly = "false"; path = ""
    next
  }
  /^[[:space:]]*\[[^[]/ {
    if (name != "") print name "\t" color "\t" readonly "\t" path
    name = ""
    next
  }
  name != "" && /^[[:space:]]*[a-z_]+[[:space:]]*=/ {
    key = $0; sub(/[[:space:]]*=.*$/, "", key); gsub(/[[:space:]]/, "", key)
    val = $0; sub(/^[^=]*=[[:space:]]*/, "", val); sub(/[[:space:]]*$/, "", val)
    if (key == "color") color = val
    else if (key == "path") path = val
    else if (key == "readonly") readonly = (tolower(val) == "true") ? "true" : "false"
  }
  END { if (name != "" && emitted < max) print name "\t" color "\t" readonly "\t" path }
' |
  jq -R -s --arg home "$HOME" --argjson maxCalendars "$max_calendars" --argjson maxField 400 '
    split("\n")
    | map(select(length > 0) | split("\t"))
    # The config belongs to whoever runs this, but the output is read straight
    # into the memory of a shell that never restarts, so it is bounded here
    # the way every other helper bounds its own.
    | .[0:$maxCalendars]
    | map({
        name: (.[0][0:$maxField]),
        color: (.[1][0:$maxField]),
        readonly: (.[2] == "true"),
        path: (.[3] | sub("^~"; $home) | .[0:$maxField])
      })
  '
