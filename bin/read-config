#!/usr/bin/env python3
"""Print a config file, read through a walked and verified descriptor.

The two shell helpers need the same guarantees the Python ones have: no
symlink anywhere in the path, a regular file at the end of it, a ceiling on
what is read, and one descriptor doing both the checking and the reading. A
shell cannot express any of that, so it asks for the bytes here instead.

Usage:
  read-config <path> <max-bytes> [--optional]

--optional makes a missing file mean an empty read rather than an error,
which is what an absent filter map is.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import almanac_fs  # noqa: E402


def main():
    args = [arg for arg in sys.argv[1:] if arg != "--optional"]
    optional = "--optional" in sys.argv[1:]
    if len(args) != 2:
        sys.exit("usage: read-config <path> <max-bytes> [--optional]")

    path, max_bytes = args[0], int(args[1])

    if optional and not os.path.lexists(os.path.expanduser(path)):
        return

    try:
        sys.stdout.buffer.write(almanac_fs.read_file(path, "config", max_bytes))
    except SystemExit as refusal:
        # 66 is EX_NOINPUT, which is what both shell helpers already report
        # when they cannot read a config.
        print(refusal.code, file=sys.stderr)
        raise SystemExit(66)


if __name__ == "__main__":
    main()
