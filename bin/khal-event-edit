#!/usr/bin/env python3
"""Edit or delete a single khal event, addressed by UID.

`khal edit` is interactive-only, so mutation has to go at the storage
directly. Filesystem calendars keep one .ics per event, so an edit is a
rewrite of that file and a delete is an unlink; khal reindexes from mtime on
its next run.

The file is located by reading UIDs rather than trusting the filename:
vdirsyncer and `khal new` both name files after the UID, but nothing in the
format requires it.

Moving an event between calendars is a file move: filesystem calendars are
directories, so the event keeps its UID and its contents and changes which
directory holds it.

Usage:
  khal-event-edit <uid> --title T [--start ISO] [--end ISO]
                        [--location L] [--description D] [--calendar NAME]
  khal-event-edit <uid> --delete
"""

import argparse
import json
import os
import select
import stat
import subprocess
import sys
import time
from datetime import date, datetime
from pathlib import Path

import icalendar

HERE = Path(__file__).resolve().parent


# Ceilings, for the same reason the panel has them: an .ics is written by
# whoever publishes the feed, and neither a runaway file nor a runaway helper
# gets to decide how much memory this takes to read one event.
MAX_HELPER_OUTPUT = 1024 * 1024
MAX_ICS_BYTES = 4 * 1024 * 1024
# The helper reads a config that can live on a mount that has stopped
# answering, where it would neither finish nor say anything for the byte
# ceiling to catch. Overridable so the tests can watch it bite.
MAX_HELPER_SECONDS = float(os.environ.get("KHAL_HELPER_TIMEOUT", 30))


def calendars():
    deadline = time.monotonic() + MAX_HELPER_SECONDS
    # Binary, so the ceiling is counted in the bytes actually read rather than
    # in characters a partial decode would have to guess at.
    process = subprocess.Popen([str(HERE / "khal-calendars")], stdout=subprocess.PIPE)

    chunks = []
    read_so_far = 0
    over = False
    timed_out = False

    while read_so_far <= MAX_HELPER_OUTPUT:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break

        ready, _, _ = select.select([process.stdout], [], [], remaining)
        if not ready:
            timed_out = True
            break

        chunk = os.read(process.stdout.fileno(), MAX_HELPER_OUTPUT + 1 - read_so_far)
        if not chunk:
            break

        chunks.append(chunk)
        read_so_far += len(chunk)

    out = b"".join(chunks).decode("utf-8", "replace")
    over = len(out) > MAX_HELPER_OUTPUT

    if over or timed_out:
        process.kill()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        process.stdout.close()
        if timed_out:
            sys.exit(f"khal-calendars did not finish within {MAX_HELPER_SECONDS:g}s")
        sys.exit("khal-calendars produced more output than can be read")

    process.stdout.close()
    try:
        status = process.wait(timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        process.kill()
        sys.exit(f"khal-calendars did not finish within {MAX_HELPER_SECONDS:g}s")
    if status != 0:
        sys.exit("khal-calendars failed")

    return json.loads(out)


def read_ics(path):
    """The file's bytes, or None if it is not an event worth parsing.

    Opened once and judged from that descriptor: a symlink is refused, and
    whether it is a regular file and how big it is are answered by the open
    file rather than by the name it was opened under. One event per file is
    the format, so anything past the ceiling is not an event, and parsing it
    would cost more than the whole search.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_ICS_BYTES:
            return None
        chunks = []
        read_so_far = 0
        while read_so_far < MAX_ICS_BYTES:
            chunk = os.read(fd, MAX_ICS_BYTES - read_so_far)
            if not chunk:
                break
            chunks.append(chunk)
            read_so_far += len(chunk)
    finally:
        os.close(fd)
    return b"".join(chunks)


def find_event(uid):
    """Return (calendar, path, component) for the event, or exit."""
    for cal in calendars():
        root = Path(os.path.expanduser(cal["path"]))
        if not root.is_dir():
            continue
        for path in root.glob("*.ics"):
            raw = read_ics(path)
            if raw is None:
                continue
            try:
                cal_obj = icalendar.Calendar.from_ical(raw)
            except ValueError:
                continue
            for component in cal_obj.walk("VEVENT"):
                if str(component.get("UID", "")) == uid:
                    return cal, path, cal_obj, component
    sys.exit(f"no event with uid {uid!r}")


def parse_when(value):
    """ISO date or datetime. A bare date means an all-day event."""
    if "T" in value:
        return datetime.fromisoformat(value)
    return date.fromisoformat(value)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("uid")
    parser.add_argument("--delete", action="store_true")
    parser.add_argument("--title")
    parser.add_argument("--start")
    parser.add_argument("--end")
    parser.add_argument("--location")
    parser.add_argument("--description")
    parser.add_argument("--calendar", help="move the event to this calendar")
    args = parser.parse_args()

    cal, path, cal_obj, event = find_event(args.uid)

    if cal["readonly"]:
        sys.exit(f"calendar {cal['name']!r} is readonly")

    if args.delete:
        path.unlink()
        print(json.dumps({"ok": True, "deleted": args.uid, "calendar": cal["name"]}))
        return

    fields = {
        "SUMMARY": args.title,
        "LOCATION": args.location,
        "DESCRIPTION": args.description,
    }
    for name, value in fields.items():
        if value is None:
            continue
        event.pop(name, None)
        event.add(name, value)

    for name, value in (("DTSTART", args.start), ("DTEND", args.end)):
        if value is None:
            continue
        event.pop(name, None)
        event.add(name, parse_when(value))

    target = path
    moved_to = cal["name"]

    if args.calendar and args.calendar != cal["name"]:
        destination = next(
            (c for c in calendars() if c["name"] == args.calendar), None
        )
        if destination is None:
            sys.exit(f"no calendar named {args.calendar!r}")
        if destination["readonly"]:
            sys.exit(f"calendar {args.calendar!r} is readonly")
        target = Path(os.path.expanduser(destination["path"])) / path.name
        if target.exists():
            sys.exit(f"{target.name} already exists in {args.calendar!r}")
        moved_to = destination["name"]

    # Written through a temp file beside the destination so a crash mid-write
    # cannot leave khal indexing a truncated event, and so a move never has
    # the event in two places at once.
    tmp = target.with_suffix(".ics.tmp")
    fd = os.open(
        tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600
    )
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(cal_obj.to_ical())
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

    # The rename is only durable once the directory holding it is, and a move
    # touches two of them.
    for directory in {target.parent, path.parent}:
        dir_fd = os.open(directory, os.O_RDONLY | os.O_CLOEXEC)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)

    if target != path:
        path.unlink()

    print(json.dumps({"ok": True, "uid": args.uid, "calendar": moved_to}))


if __name__ == "__main__":
    main()
