#!/usr/bin/env python3
"""Edit or delete a single khal event, addressed by UID.

`khal edit` is interactive-only, so mutation has to go at the storage
directly. Filesystem calendars keep one .ics per event, so an edit is a
rewrite of that file and a delete is an unlink; khal reindexes from mtime on
its next run.

The file is located by reading UIDs rather than trusting the filename:
vdirsyncer and `khal new` both name files after the UID, but nothing in the
format requires it.

Moving an event between calendars is a file move: filesystem calendars are
directories, so the event keeps its UID and its contents and changes which
directory holds it.

Usage:
  khal-event-edit <uid> --title T [--start ISO] [--end ISO]
                        [--location L] [--description D] [--calendar NAME]
  khal-event-edit <uid> --delete
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import date, datetime
from pathlib import Path

import icalendar

HERE = Path(__file__).resolve().parent


def calendars():
    out = subprocess.run(
        [str(HERE / "khal-calendars")], capture_output=True, text=True, check=True
    ).stdout
    return json.loads(out)


def find_event(uid):
    """Return (calendar, path, component) for the event, or exit."""
    for cal in calendars():
        root = Path(os.path.expanduser(cal["path"]))
        if not root.is_dir():
            continue
        for path in root.glob("*.ics"):
            try:
                cal_obj = icalendar.Calendar.from_ical(path.read_bytes())
            except ValueError:
                continue
            for component in cal_obj.walk("VEVENT"):
                if str(component.get("UID", "")) == uid:
                    return cal, path, cal_obj, component
    sys.exit(f"no event with uid {uid!r}")


def parse_when(value):
    """ISO date or datetime. A bare date means an all-day event."""
    if "T" in value:
        return datetime.fromisoformat(value)
    return date.fromisoformat(value)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("uid")
    parser.add_argument("--delete", action="store_true")
    parser.add_argument("--title")
    parser.add_argument("--start")
    parser.add_argument("--end")
    parser.add_argument("--location")
    parser.add_argument("--description")
    parser.add_argument("--calendar", help="move the event to this calendar")
    args = parser.parse_args()

    cal, path, cal_obj, event = find_event(args.uid)

    if cal["readonly"]:
        sys.exit(f"calendar {cal['name']!r} is readonly")

    if args.delete:
        path.unlink()
        print(json.dumps({"ok": True, "deleted": args.uid, "calendar": cal["name"]}))
        return

    fields = {
        "SUMMARY": args.title,
        "LOCATION": args.location,
        "DESCRIPTION": args.description,
    }
    for name, value in fields.items():
        if value is None:
            continue
        event.pop(name, None)
        event.add(name, value)

    for name, value in (("DTSTART", args.start), ("DTEND", args.end)):
        if value is None:
            continue
        event.pop(name, None)
        event.add(name, parse_when(value))

    target = path
    moved_to = cal["name"]

    if args.calendar and args.calendar != cal["name"]:
        destination = next(
            (c for c in calendars() if c["name"] == args.calendar), None
        )
        if destination is None:
            sys.exit(f"no calendar named {args.calendar!r}")
        if destination["readonly"]:
            sys.exit(f"calendar {args.calendar!r} is readonly")
        target = Path(os.path.expanduser(destination["path"])) / path.name
        if target.exists():
            sys.exit(f"{target.name} already exists in {args.calendar!r}")
        moved_to = destination["name"]

    # Written through a temp file beside the destination so a crash mid-write
    # cannot leave khal indexing a truncated event, and so a move never has
    # the event in two places at once.
    tmp = target.with_suffix(".ics.tmp")
    tmp.write_bytes(cal_obj.to_ical())
    tmp.replace(target)
    if target != path:
        path.unlink()

    print(json.dumps({"ok": True, "uid": args.uid, "calendar": moved_to}))


if __name__ == "__main__":
    main()
