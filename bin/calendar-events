#!/usr/bin/env bash
# Args: start end, both ISO (yyyy-mm-dd). Emits a JSON array of
# {date, time, title} for that range, MLB filtered down to Cardinals games
# (STL) since the raw feed is ~15 games/day of noise otherwise.

set -u

to_khal() {
  IFS='-' read -r y m d <<<"$1"
  printf '%02d/%02d/%04d' "$((10#$d))" "$((10#$m))" "$((10#$y))"
}

start_khal=$(to_khal "$1")
end_khal=$(to_khal "$2")

{
  khal list "$start_khal" "$end_khal" -d sports_mlb --json start-date --json start-time --json title 2>/dev/null
  khal list "$start_khal" "$end_khal" -a sports_mlb --json start-date --json start-time --json title 2>/dev/null \
    | jq -c '[.[] | select(.title | test("STL"))]'
} | jq -s '
    add
    | map({
        date: (.["start-date"] | split("/") | .[2] + "-" + .[1] + "-" + .[0]),
        time: .["start-time"],
        title: .title
      })
    | unique
    | sort_by(.date, .time)
  '
